   "source": [
    "my_list=[1,2,3,4,5,6,7]\n",
    "index_remove=[0,2,5]\n",
    "revised=[]\n",
    "for index,value in enumerate(my_list):\n",
    "    if(index not in index_remove):\n",
    "        revised.append(value)\n",
    "print(\"Revised list is \",revised)"
   ]
