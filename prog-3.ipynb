   "source": [
    "prog-3 convert date str to date object"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "ab8a0830",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<class 'str'>\n",
      "2026-07-23 00:00:00 <class 'datetime.datetime'>\n",
      "23 July 2026 <class 'str'>\n"
     ]
    }
   ],
   "source": [
    "import datetime\n",
    "date_str=\"23 jul 2026\"\n",
    "print(type(date_str))\n",
    "date_obj=datetime.datetime.strptime(date_str,\"%d %b %Y\")\n",
    "print(date_obj,type(date_obj))\n",
    "back_str=date_obj.strftime(\"%d %B %Y\")\n",
    "print(back_str,type(back_str))"
   ]
  }
